# Copier en scripts/.env.production (ignore par git) et adapter.
# Aucun secret ici : l'authentification se fait par cle SSH (agent ou ~/.ssh/config).
SSH_TARGET=mvuillem@example.com
# SSH_OPTS="-p 22 -i ~/.ssh/id_ed25519"
WEB_DIR=/home/mvuillem/public_html/hydroflow
PROXY_DIR=/home/mvuillem/public_html/api/vigicrues
# Sous-chemin public de la webapp (slashs de debut et de fin)
WEB_BASE=/hydroflow/
# URL publique du proxy, integree au build
PROXY_PUBLIC_URL=https://example.com/api/vigicrues
