{
  "name": "hydroflow-monorepo",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "license": "GPLv3",
  "workspaces": [
    "apps/web",
    "apps/vigicrues-proxy"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:web dev:proxy",
    "dev:web": "npm run dev --workspace apps/web",
    "dev:proxy": "npm run start --workspace apps/vigicrues-proxy",
    "build": "npm run build --workspace apps/web",
    "preview": "npm run preview --workspace apps/web",
    "typecheck": "npm run typecheck --workspace apps/web",
    "test": "npm run test --workspaces --if-present",
    "coverage": "npm run coverage --workspace apps/web"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  },
  "allowScripts": {
    "msw@2.15.0": true
  }
}
