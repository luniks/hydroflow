# Proxy Vigicrues (CORS + cache). En dev, lancer `npm run dev:proxy` a la racine.
VITE_VIGICRUES_PROXY_URL=http://127.0.0.1:3000/vigicrues

# APIs publiques (surchargeables pour tests ou miroirs)
VITE_HUBEAU_URL=https://hubeau.eaufrance.fr/api/v2/hydrometrie
VITE_OPENMETEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
VITE_OPENMETEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search

# Territoire Vigicrues suivi
VITE_VIGICRUES_TERRITORY=TL1
